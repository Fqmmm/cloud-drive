# start.ps1 generates independent random credentials in the ignored root .env.
COMPOSE_PROJECT_NAME=cloud-drive-course
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
APP_IMAGE_TAG=local
NPM_REGISTRY=https://registry.npmjs.org
MAVEN_MIRROR_URL=
MYSQL_IMAGE=mysql:8.0.29@sha256:152cf187a3efc56afb0b3877b4d21e231d1d6eb828ca9221056590b0ac834c75
MINIO_IMAGE=dappros/minio@sha256:624bad2fe79a8613aa3c5c9b765ebcab365080b8445cf1b05c357cc7753725f0
MYSQL_ROOT_PASSWORD=replace-root-password
AUTH_DB_PASSWORD=replace-auth-password
FILE_DB_PASSWORD=replace-file-password
SHARE_DB_PASSWORD=replace-share-password
MINIO_ROOT_USER=course-storage
MINIO_ROOT_PASSWORD=replace-minio-password
JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
JWT_ISSUER=course-drive
JWT_AUDIENCE=course-drive-api
JWT_TTL_SECONDS=7200
INTERNAL_API_TOKEN=replace-with-a-distinct-internal-credential
DEFAULT_QUOTA_BYTES=10737418240
MAX_FILE_BYTES=104857600
MAX_REQUEST_SIZE=106954752B
SHARE_CODE_MAX_FAILURES=5
SHARE_CODE_WINDOW_SECONDS=60
EXPERIMENT_FAULTS_ENABLED=false
AUTH_APP_VERSION=course-v1
SHARE_APP_VERSION=course-v1
