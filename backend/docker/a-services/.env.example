# Copy to an ignored *.local file and replace all credential placeholders.
MYSQL_ROOT_PASSWORD=replace-root-password
AUTH_DB_PASSWORD=replace-auth-password
FILE_DB_PASSWORD=replace-file-password
SHARE_DB_PASSWORD=replace-share-password
MINIO_ROOT_USER=replace-minio-user
MINIO_ROOT_PASSWORD=replace-minio-password
MINIO_IMAGE=cloud-drive-minio:release-2025-09-07
JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
JWT_ISSUER=course-drive
JWT_AUDIENCE=course-drive-api
INTERNAL_API_TOKEN=replace-with-a-distinct-internal-credential
PUBLIC_BASE_URL=http://localhost:8080
A_DEV_HTTP_PORT=8080
DEFAULT_QUOTA_BYTES=10737418240
MAX_FILE_BYTES=104857600
MAX_REQUEST_SIZE=106954752B
EXPERIMENT_FAULTS_ENABLED=false
